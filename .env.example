# Copy to .env (read by docker compose). Everything is optional.

# Without a key the service runs in stub mode: it still calls Anthropic, then uses a static Draft.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_RATE_LIMIT_PER_MINUTE=60

OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator

WORKER_THREADS=30
HELPDESK_TIMEOUT_SECONDS=10

# Mock Helpdesk fault injection: share of 503s, share of late answers, and how late.
MOCK_HELPDESK_FAILURE_RATE=0.2
MOCK_HELPDESK_SLOW_RATE=0.1
MOCK_HELPDESK_SLOW_SECONDS=15
